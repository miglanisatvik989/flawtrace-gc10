# Local datasets; retain the policy and future provenance manifests.
/data/*
!/data/README.md
!/data/manifests/

# Dataset copies and archives outside data/.
/datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Model weights and exported models.
/weights/
/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.h5
*.hdf5

# Generated experiment artifacts; keep curated metadata in docs/ or configs/.
/experiments/
/runs/
/outputs/
/results/
/logs/
*.log

# Python caches, packaging, and tool caches.
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
*.egg-info/
/build/
/dist/

# Virtual environments.
.venv/
venv/
env/
.env/
.conda/

# Credentials and local environment settings.
.env
.env.*
.netrc
.pypirc
.aws/
.ssh/
credentials/
credentials*.json
*service-account*.json
secrets/
secrets.*
*.pem
*.key

# Local editor and OS state.
.idea/
.vscode/
.DS_Store
Thumbs.db
